{
  "id": "fastcar-REPLACE_ME_NAMESPACE",
  "namespace": "REPLACE_ME_NAMESPACE",
  "routes": [{ "path_prefix": "/" }],
  "auth": {
    "provider_ref": "heyo",
    "public_paths": [{ "path": "/api/health", "scope": "public" }]
  },
  "vm": {
    "driver": "firecracker",
    "image": "fastcar",
    "port": 3000,
    "start_command": "/opt/fastcar/start.sh",
    "size_class": "medium",
    "disk_size_gb": 10,
    "env_vars": {
      "FASTCAR_MOCK": "1",
      "PORT": "3000"
    }
  },
  "scaling": {
    "min_replicas": 0,
    "max_replicas": 1,
    "scale_to_zero_after_secs": 1800,
    "cold_start_timeout_secs": 240,
    "boot_timeout_secs": 300
  },
  "health": { "path": "/api/health", "timeout_secs": 2 }
}
