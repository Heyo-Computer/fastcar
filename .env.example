# Copy to .env at the repo root; the server loads it automatically (real
# environment variables still win). Blank values below count as unset.

# --- Database (required) ---
# 5433 matches the dev container in the README, so it never fights a local
# Postgres already on 5432.
DATABASE_URL=postgres://fastcar:fastcar@localhost:5433/fastcar

# --- Inference: conductor (InceptionLabs Mercury, direct) ---
INCEPTION_API_KEY=
# Chat model id (Mercury 2.5 takes reasoning_effort: instant | medium | high)
INCEPTION_MODEL=mercury-2.5
# max_tokens per request — shared by reasoning and the answer. Raise it if
# high-effort turns stop with finish_reason "length".
INCEPTION_MAX_TOKENS=16384
# Boot-time reasoning effort; the ⚙ settings modal overrides it at runtime.
CONDUCTOR_REASONING_EFFORT=medium

# --- Inference: everything else (OpenRouter) ---
OPENROUTER_API_KEY=
# Heavyweight coding model for the "maxcoding" subagent (OpenRouter slug)
MAXCODING_MODEL=anthropic/claude-sonnet-4.5
# Cheap/fast model for the "minimodel" subagent
MINIMODEL_MODEL=google/gemini-2.5-flash-lite
# Speech-to-text model (OpenRouter /audio/transcriptions)
TRANSCRIBE_MODEL=openai/whisper-large-v3

# --- Web search ---
TAVILY_API_KEY=

# --- Git ---
# Where cloned repositories live. Defaults to <workdir>/repos.
FASTCAR_REPOS_DIR=
# Commit identity used when the VM has no global git config.
FASTCAR_GIT_NAME=fastcar
FASTCAR_GIT_EMAIL=fastcar@localhost

# --- MCP servers ---
# Where servers installed with mcp_install are cloned and built. Defaults to
# <FASTCAR_DATA_DIR>/mcp.
FASTCAR_MCP_DIR=
# Key for the secrets fastcar keeps at rest (SMTP password, MCP env vars and
# headers). Defaults to a value derived from the data dir path — set it on a
# real deployment.
FASTCAR_SECRET=

# --- App ---
PORT=3000
# Externally reachable origin, used to build the public artifact URLs the agent
# hands out (/artifacts/<id>/<name>). Defaults to http://localhost:$PORT.
FASTCAR_PUBLIC_URL=
# Directory the agents operate on (their cwd). Defaults to the process cwd.
FASTCAR_WORKDIR=
# App-owned state: pi auth/models files + JSONL session dir. Keep OUTSIDE the workdir.
FASTCAR_DATA_DIR=./.fastcar
# 1 = run against the built-in mock OpenAI server (no API keys needed)
FASTCAR_MOCK=0
